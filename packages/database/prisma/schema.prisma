// ESCRIBIENDO — esquema de datos
// Todas las tablas usan UUID. La aplicación normaliza los correos a minúsculas
// antes de escribir para que la restricción UNIQUE sea efectivamente
// insensible a mayúsculas sin depender de la extensión citext.
//
// Las revisiones de sección son inmutables a nivel de aplicación. La migración
// inicial añade además una protección a nivel de PostgreSQL contra UPDATE.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identidad y espacio de trabajo
// ---------------------------------------------------------------------------

enum UserRole {
  SUPERADMIN
  ADMIN
  AUTHOR
  EDITOR
  REVIEWER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  AUTHOR
  REVIEWER
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(320)
  name                String    @db.VarChar(120)
  passwordHash        String    @db.Text
  role                UserRole  @default(AUTHOR)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  ownedWorkspaces        Workspace[]           @relation("WorkspaceOwner")
  memberships            WorkspaceMember[]
  sessions               Session[]
  resetTokens            PasswordResetToken[]
  booksCreated           Book[]                @relation("BookCreatedBy")
  revisions              SectionRevision[]     @relation("RevisionCreatedBy")
  assetsCreated          Asset[]               @relation("AssetCreatedBy")
  exportJobs             ExportJob[]           @relation("ExportRequestedBy")
  writingNotes           WritingNote[]
  writingGoals           WritingGoal[]
  commentsAuthored       EditorialComment[]    @relation("CommentAuthor")
  commentsResolved       EditorialComment[]    @relation("CommentResolver")
  commentsAssigned       EditorialComment[]    @relation("CommentAssignee")
  sectionsAssigned       BookSection[]         @relation("SectionAssignee")
  invitationsSent        WorkspaceInvitation[] @relation("InvitationAuthor")
  auditLogs              AuditLog[]            @relation("AuditActor")
  storyPlanItemsCreated  StoryPlanItem[]       @relation("StoryPlanItemCreatedBy")
  storyCharactersCreated StoryCharacter[]      @relation("StoryCharacterCreatedBy")
  storyWorldsCreated     StoryWorld[]          @relation("StoryWorldCreatedBy")

  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model Workspace {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(160)
  slug      String    @unique @db.VarChar(80)
  ownerId   String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  owner              User                     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members            WorkspaceMember[]
  invitations        WorkspaceInvitation[]
  books              Book[]
  layoutProfiles     LayoutProfile[]
  editorialTemplates EditorialTemplate[]
  assets             Asset[]
  auditLogs          AuditLog[]
  storyPlanItems     StoryPlanItem[]
  storyCharacters    StoryCharacter[]
  characterRelations StoryCharacterRelation[]
  characterEvents    StoryCharacterEvent[]
  storyWorlds        StoryWorld[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(AUTHOR)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
  @@map("workspace_members")
}

/// Invitación para entrar en un espacio de trabajo.
///
/// El token no se guarda en claro: solo su huella, como las sesiones. La
/// invitación caduca y se puede revocar sin que quede nada utilizable.
model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String        @db.VarChar(320)
  role        WorkspaceRole @default(AUTHOR)
  tokenHash   String        @unique @db.VarChar(64)
  invitedById String        @db.Uuid
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationAuthor", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([email])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  userId      String    @db.Uuid
  expiresAt   DateTime
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?
  ipHash      String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now())
  /**
   * Espacio de trabajo con el que se está trabajando.
   * Una persona puede pertenecer a varios estudios. Sin este dato, la sesión
   * siempre caía en el más antiguo y quien aceptaba una invitación a otro
   * estudio no llegaba a verlo.
   */
  workspaceId String?   @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([workspaceId])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Biblioteca y estructura editorial
// ---------------------------------------------------------------------------

enum BookStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  COMPLETE
  ARCHIVED
}

enum SectionType {
  HALF_TITLE
  TITLE_PAGE
  COPYRIGHT
  DEDICATION
  EPIGRAPH
  TABLE_OF_CONTENTS
  FOREWORD
  PROLOGUE
  INTRODUCTION
  PART
  CHAPTER
  SUBCHAPTER
  INTERLUDE
  EPILOGUE
  ACKNOWLEDGMENTS
  AUTHOR_NOTES
  ABOUT_AUTHOR
  BIBLIOGRAPHY
  GLOSSARY
  APPENDIX
  OTHER_BOOKS
  CUSTOM
}

enum RevisionReason {
  AUTO
  MANUAL
  RESTORE
  IMPORT
}

model Book {
  id              String     @id @default(uuid()) @db.Uuid
  workspaceId     String     @db.Uuid
  createdById     String     @db.Uuid
  title           String     @db.VarChar(300)
  subtitle        String?    @db.VarChar(300)
  authorName      String     @db.VarChar(200)
  penName         String?    @db.VarChar(200)
  description     String?    @db.Text
  genre           String?    @db.VarChar(100)
  language        String     @default("es") @db.VarChar(10)
  status          BookStatus @default(DRAFT)
  targetWordCount Int?
  wordCount       Int        @default(0)
  chapterCount    Int        @default(0)
  writingProgress Decimal    @default(0) @db.Decimal(5, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  archivedAt      DateTime?
  deletedAt       DateTime?

  workspace          Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("BookCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sections           BookSection[]
  editions           BookEdition[]
  assets             BookAsset[]
  exportJobs         ExportJob[]
  notes              WritingNote[]
  goals              WritingGoal[]
  comments           EditorialComment[]
  storyPlanItems     StoryPlanItem[]
  storyCharacters    StoryCharacter[]
  characterRelations StoryCharacterRelation[]
  characterEvents    StoryCharacterEvent[]
  storyWorlds        StoryWorld[]

  @@index([workspaceId, deletedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
  @@index([archivedAt])
  @@map("books")
}

model BookSection {
  id              String      @id @default(uuid()) @db.Uuid
  bookId          String      @db.Uuid
  parentId        String?     @db.Uuid
  type            SectionType
  title           String      @db.VarChar(300)
  content         Json        @default("{}")
  wordCount       Int         @default(0)
  version         Int         @default(1)
  sortOrder       Int         @default(0)
  showInToc       Boolean     @default(true)
  includeInExport Boolean     @default(true)
  pageBreakBefore Boolean     @default(false)
  startOnOddPage  Boolean     @default(false)
  isHidden        Boolean     @default(false)
  /// Persona a la que se asigna el trabajo de esta sección.
  assigneeId      String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  book      Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  parent    BookSection?       @relation("SectionHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  BookSection[]      @relation("SectionHierarchy")
  revisions SectionRevision[]
  notes     WritingNote[]
  comments  EditorialComment[]
  assignee  User?              @relation("SectionAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([bookId, parentId, sortOrder])
  @@index([bookId, type])
  @@index([bookId, deletedAt])
  @@index([assigneeId])
  @@map("book_sections")
}

model SectionRevision {
  id          String         @id @default(uuid()) @db.Uuid
  sectionId   String         @db.Uuid
  createdById String         @db.Uuid
  version     Int
  content     Json
  wordCount   Int            @default(0)
  reason      RevisionReason @default(AUTO)
  title       String         @db.VarChar(300)
  createdAt   DateTime       @default(now())

  section   BookSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdBy User        @relation("RevisionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([sectionId, version])
  @@index([sectionId, createdAt])
  @@index([createdById])
  @@map("section_revisions")
}

// ---------------------------------------------------------------------------
// Ediciones, maquetación y plantillas
// ---------------------------------------------------------------------------

enum BookFormat {
  A4
  A5
  B5
  INCH_5X8
  INCH_5_5X8_5
  INCH_6X9
  POCKET
  CUSTOM
}

enum EditionStatus {
  DRAFT
  READY
  ARCHIVED
}

model BookEdition {
  id                  String        @id @default(uuid()) @db.Uuid
  bookId              String        @db.Uuid
  layoutProfileId     String?       @db.Uuid
  editorialTemplateId String?       @db.Uuid
  name                String        @db.VarChar(160)
  format              BookFormat    @default(A5)
  status              EditionStatus @default(DRAFT)
  isDefault           Boolean       @default(false)
  pageCount           Int?
  paperStock          String?       @db.VarChar(120)
  spineWidthMm        Decimal?      @db.Decimal(6, 2)
  settings            Json          @default("{}")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  book              Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  layoutProfile     LayoutProfile?     @relation(fields: [layoutProfileId], references: [id], onDelete: SetNull)
  editorialTemplate EditorialTemplate? @relation(fields: [editorialTemplateId], references: [id], onDelete: SetNull)
  exportJobs        ExportJob[]

  @@unique([bookId, name])
  @@index([bookId, isDefault])
  @@index([layoutProfileId])
  @@index([editorialTemplateId])
  @@map("book_editions")
}

model LayoutProfile {
  id                 String     @id @default(uuid()) @db.Uuid
  workspaceId        String     @db.Uuid
  name               String     @db.VarChar(160)
  format             BookFormat @default(A5)
  pageWidthMm        Decimal    @db.Decimal(6, 2)
  pageHeightMm       Decimal    @db.Decimal(6, 2)
  marginTopMm        Decimal    @db.Decimal(6, 2)
  marginBottomMm     Decimal    @db.Decimal(6, 2)
  marginInnerMm      Decimal    @db.Decimal(6, 2)
  marginOuterMm      Decimal    @db.Decimal(6, 2)
  gutterMm           Decimal    @default(0) @db.Decimal(6, 2)
  bleedMm            Decimal    @default(0) @db.Decimal(6, 2)
  headerDistanceMm   Decimal    @default(8) @db.Decimal(6, 2)
  footerDistanceMm   Decimal    @default(8) @db.Decimal(6, 2)
  mirrorMargins      Boolean    @default(true)
  showPageNumbers    Boolean    @default(true)
  chapterStartsRecto Boolean    @default(true)
  typographyConfig   Json       @default("{}")
  advancedConfig     Json       @default("{}")
  isDefault          Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editions  BookEdition[]

  @@unique([workspaceId, name])
  @@index([workspaceId, isDefault])
  @@index([workspaceId, deletedAt])
  @@map("layout_profiles")
}

model EditorialTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String?   @db.Uuid
  name        String    @db.VarChar(160)
  slug        String    @db.VarChar(80)
  description String?   @db.Text
  config      Json      @default("{}")
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  editions  BookEdition[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([isSystem])
  @@index([deletedAt])
  @@map("editorial_templates")
}

// ---------------------------------------------------------------------------
// Recursos gráficos
// ---------------------------------------------------------------------------

enum StorageProvider {
  CLOUDINARY
}

enum AssetResourceType {
  IMAGE
}

enum AssetKind {
  COVER_FRONT
  COVER_BACK
  SPINE
  FULL_COVER
  INTERIOR_IMAGE
  OTHER
}

model Asset {
  id               String            @id @default(uuid()) @db.Uuid
  workspaceId      String            @db.Uuid
  createdById      String?           @db.Uuid
  provider         StorageProvider   @default(CLOUDINARY)
  resourceType     AssetResourceType @default(IMAGE)
  publicId         String            @unique @db.VarChar(512)
  secureUrl        String            @db.Text
  format           String            @db.VarChar(20)
  width            Int?
  height           Int?
  bytes            Int?
  originalFilename String?           @db.VarChar(255)
  version          String?           @db.VarChar(40)
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  bookLinks BookAsset[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, deletedAt])
  @@index([createdById])
  @@map("assets")
}

model BookAsset {
  id        String    @id @default(uuid()) @db.Uuid
  bookId    String    @db.Uuid
  assetId   String    @db.Uuid
  kind      AssetKind
  caption   String?   @db.VarChar(300)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([bookId, assetId, kind])
  @@index([bookId, kind, sortOrder])
  @@index([assetId])
  @@map("book_assets")
}

// ---------------------------------------------------------------------------
// Exportaciones, notas y auditoría
// ---------------------------------------------------------------------------

enum ExportFormat {
  PDF_DIGITAL
  PDF_PRINT
  EPUB3
  DOCX
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model ExportJob {
  id              String       @id @default(uuid()) @db.Uuid
  bookId          String       @db.Uuid
  editionId       String?      @db.Uuid
  requestedById   String?      @db.Uuid
  format          ExportFormat
  status          ExportStatus @default(PENDING)
  idempotencyKey  String       @db.VarChar(120)
  manuscriptHash  String       @db.VarChar(64)
  sectionVersions Json         @default("[]")
  options         Json         @default("{}")
  progress        Int          @default(0)
  errorCode       String?      @db.VarChar(80)
  errorMessage    String?      @db.Text
  resultMetadata  Json?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  book        Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  edition     BookEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  requestedBy User?        @relation("ExportRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([bookId, idempotencyKey])
  @@index([bookId, createdAt])
  @@index([status, createdAt])
  @@index([editionId])
  @@index([requestedById])
  @@map("export_jobs")
}

model WritingNote {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  bookId    String    @db.Uuid
  sectionId String?   @db.Uuid
  title     String    @db.VarChar(200)
  content   String    @db.Text
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  book    Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  section BookSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([userId, isPinned, updatedAt])
  @@index([bookId])
  @@index([sectionId])
  @@map("writing_notes")
}

/// Objetivo de escritura de un usuario para un periodo concreto.
///
/// El objetivo por libro vive en `books.targetWordCount`. Este modelo cubre
/// el objetivo diario o semanal, que es la unidad con la que se trabaja a
/// diario.
model WritingGoal {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  bookId      String?  @db.Uuid
  periodStart DateTime
  periodEnd   DateTime
  targetWords Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book? @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@index([bookId])
  @@map("writing_goals")
}

// ---------------------------------------------------------------------------
// Herramientas de historia: planificación, personajes y mundos
// ---------------------------------------------------------------------------

enum StoryPlanKind {
  ACT
  CHAPTER
  SCENE
  SEQUENCE
  OTHER
}

enum StoryPlanStatus {
  IDEA
  PLANNED
  WRITING
  DONE
}

enum CharacterRole {
  PROTAGONIST
  ANTAGONIST
  SECONDARY
  MENTOR
  LOVE_INTEREST
  OTHER
}

enum WorldKind {
  PLACE
  CULTURE
  ORGANIZATION
  SYSTEM
  OBJECT
  EVENT
  OTHER
}

/// Idea, escena o hito del plan de una historia.
///
/// Puede pertenecer a un libro concreto o al estudio en general, para las
/// ideas que todavía no tienen destino. No sustituye a las secciones del
/// manuscrito: es el mapa previo de lo que se quiere contar.
model StoryPlanItem {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  bookId      String?         @db.Uuid
  createdById String?         @db.Uuid
  title       String          @db.VarChar(200)
  summary     String?         @db.Text
  kind        StoryPlanKind   @default(SCENE)
  status      StoryPlanStatus @default(IDEA)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book      Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("StoryPlanItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, bookId])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("story_plan_items")
}

/// Ficha de personaje de la biblia de la historia.
///
/// Igual que el plan, puede estar vinculada a un libro o ser general del
/// estudio. El borrado es lógico: una ficha eliminada no se pierde de forma
/// inmediata y puede auditarse.
model StoryCharacter {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  bookId      String?       @db.Uuid
  createdById String?       @db.Uuid
  name        String        @db.VarChar(160)
  role        CharacterRole @default(OTHER)
  age         String?       @db.VarChar(40)
  occupation  String?       @db.VarChar(120)
  summary     String?       @db.VarChar(300)
  description String?       @db.Text
  personality String?       @db.Text
  motivation  String?       @db.Text
  conflict    String?       @db.Text
  arc         String?       @db.Text
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book              Book?                    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy         User?                    @relation("StoryCharacterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  outgoingRelations StoryCharacterRelation[] @relation("CharacterRelationSource")
  incomingRelations StoryCharacterRelation[] @relation("CharacterRelationTarget")
  events            StoryCharacterEvent[]

  @@index([workspaceId, bookId])
  @@index([workspaceId, role])
  @@index([workspaceId, createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("story_characters")
}

enum CharacterRelationshipKind {
  FAMILY
  FRIENDSHIP
  ROMANCE
  RIVALRY
  CONFLICT
  ALLIANCE
  OTHER
}

model StoryCharacterRelation {
  id                String                    @id @default(uuid()) @db.Uuid
  workspaceId       String                    @db.Uuid
  bookId            String                    @db.Uuid
  sourceCharacterId String                    @db.Uuid
  targetCharacterId String                    @db.Uuid
  kind              CharacterRelationshipKind
  description       String?                   @db.VarChar(300)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book              Book                      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  source            StoryCharacter            @relation("CharacterRelationSource", fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  target            StoryCharacter            @relation("CharacterRelationTarget", fields: [targetCharacterId], references: [id], onDelete: Cascade)

  @@unique([sourceCharacterId, targetCharacterId, kind])
  @@index([workspaceId, bookId])
  @@map("story_character_relations")
}

model StoryCharacterEvent {
  id            String         @id @default(uuid()) @db.Uuid
  workspaceId   String         @db.Uuid
  bookId        String         @db.Uuid
  characterId   String         @db.Uuid
  sectionId     String?        @db.Uuid
  title         String         @db.VarChar(200)
  details       String?        @db.Text
  sourceExcerpt String?        @db.Text
  sequence      Int            @default(0)
  suggested     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book          Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  character     StoryCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([workspaceId, bookId, characterId, sequence])
  @@index([sectionId])
  @@map("story_character_events")
}

/// Lugar, cultura, organización o regla del mundo de una historia.
model StoryWorld {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid
  bookId      String?   @db.Uuid
  createdById String?   @db.Uuid
  name        String    @db.VarChar(160)
  kind        WorldKind @default(PLACE)
  summary     String?   @db.VarChar(300)
  description String?   @db.Text
  rules       String?   @db.Text
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  book      Book?     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("StoryWorldCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, bookId])
  @@index([workspaceId, kind])
  @@index([workspaceId, createdAt])
  @@index([createdById])
  @@index([deletedAt])
  @@map("story_worlds")
}

/// Comentario editorial sobre un libro o una sección concreta.
///
/// Es visible para todo el espacio de trabajo, a diferencia de las notas, que
/// son privadas de su autor.
model EditorialComment {
  id           String        @id @default(uuid()) @db.Uuid
  bookId       String        @db.Uuid
  sectionId    String?       @db.Uuid
  authorId     String        @db.Uuid
  body         String        @db.Text
  status       CommentStatus @default(OPEN)
  resolvedAt   DateTime?
  resolvedById String?       @db.Uuid
  /// Persona a la que se asigna el comentario.
  assigneeId   String?       @db.Uuid
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  book       Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  section    BookSection? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  author     User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  resolvedBy User?        @relation("CommentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  assignee   User?        @relation("CommentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([bookId, status])
  @@index([sectionId])
  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([assigneeId])
  @@map("editorial_comments")
}

enum CommentStatus {
  OPEN
  RESOLVED
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String?  @db.Uuid
  actorId     String?  @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(60)
  entityId    String?  @db.VarChar(64)
  requestId   String?  @db.VarChar(64)
  ipHash      String?  @db.VarChar(64)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
