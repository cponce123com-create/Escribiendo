# ESCRIBIENDO — variables de entorno
#
# Copia este archivo como .env en la raíz del repositorio y completa los
# valores. Nunca confirmes .env en el control de versiones.
#
# En producción (Render) estas variables se configuran en el panel del
# servicio. Las variables marcadas con «sync: false» en render.yaml deben
# introducirse manualmente.

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------

# URL pública exacta de la aplicación, sin barra final.
# Desarrollo: http://localhost:3000
# Producción: https://tu-servicio.onrender.com
APP_URL="http://localhost:3000"

# No definas NODE_ENV aquí. Next.js lo establece por sí mismo y, si el proceso
# hereda NODE_ENV=development, `next build` falla al prerenderizar
# /_global-error con «Cannot read properties of null (reading 'useContext')».
# `pnpm build` ya fija production; los detalles están en docs/TESTING.md.

# ---------------------------------------------------------------------------
# Base de datos (Neon PostgreSQL)
# ---------------------------------------------------------------------------

# URL agrupada (pooled) que usa la aplicación en ejecución.
# En Neon, el host contiene «-pooler». Añade pgbouncer=true y un límite de
# conexiones bajo: Render Free comparte recursos y Neon Free limita el total.
DATABASE_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=3&connect_timeout=15"

# URL directa (sin pooler) que usan Prisma Migrate y los scripts de
# administración. No debe incluir pgbouncer=true.
DIRECT_URL="postgresql://USUARIO:CONTRASENA@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Instalación inicial
# ---------------------------------------------------------------------------

# Token de un solo uso para crear la primera cuenta en /setup.
# Debe tener al menos 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Después de crear la primera cuenta, elimina esta variable del entorno.
SETUP_TOKEN=""

# Duración de la sesión en días (1–90).
SESSION_TTL_DAYS="14"

# Cantidad de entradas de X-Forwarded-For contadas desde la derecha (0: no confiar).
TRUSTED_PROXY_HOPS="1"

# Nivel de registro: debug | info | warn | error.
LOG_LEVEL="debug"

# Límite de intentos de acceso por dirección IP. Los valores por defecto son
# los de producción: 10 intentos cada 15 minutos. Se pueden ajustar porque el
# presupuesto depende del entorno (una suite automatizada que abre muchas
# sesiones desde la misma dirección necesita más margen).
# RATE_LIMIT_LOGIN_ATTEMPTS="10"
# RATE_LIMIT_LOGIN_WINDOW_MINUTES="15"

# ---------------------------------------------------------------------------
# Firma de las descargas de exportación (opcional)
# ---------------------------------------------------------------------------
# Clave con la que se firman las direcciones de descarga de los archivos
# exportados. Debe tener al menos 32 caracteres aleatorios. Genera uno con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
#
# Si no se define, la clave se deriva de las credenciales de la base de
# datos, que ya son un secreto. Definirla es más limpio y permite rotarla
# sin tocar la base de datos.
# EXPORT_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary (opcional en Fase 1, necesario para subir imágenes)
# ---------------------------------------------------------------------------

# Las tres variables deben estar presentes a la vez o ausentes por completo.
# Deja en blanco las que no uses: una cadena vacía equivale a «no configurada».
# El secreto solo se usa en el servidor para firmar subidas directas.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Carpeta raíz dentro de Cloudinary. Solo minúsculas, números, guiones,
# guiones bajos y barras.
CLOUDINARY_UPLOAD_FOLDER="escribiendo"

# ---------------------------------------------------------------------------
# Herramientas
# ---------------------------------------------------------------------------

# Evita que Next.js envíe telemetría anónima.
NEXT_TELEMETRY_DISABLED="1"

# Solo para pruebas E2E: URL de la aplicación ya iniciada. Si se define,
# Playwright no arranca un servidor propio.
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"

# Solo para pruebas E2E contra una base de datos desechable: permite crear la
# cuenta inicial y ejecutar el flujo de autenticación.
#
# La preparación global de Playwright VACÍA todas las tablas de la base
# configurada en DATABASE_URL. Por seguridad, aborta si el nombre de la base
# no contiene «test».
#
# E2E_SETUP_TOKEN=""      # si se define, tiene prioridad sobre SETUP_TOKEN
# E2E_USER_EMAIL="e2e@ejemplo.local"
# E2E_USER_PASSWORD=""
