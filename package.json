{
  "name": "escribiendo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma editorial de EDITORIAL NO PARA TODOS",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "pnpm db:generate && pnpm --filter @escribiendo/web dev",
    "build": "pnpm db:generate && NODE_ENV=production pnpm --filter @escribiendo/web build",
    "start": "pnpm --filter @escribiendo/web start",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive --if-present typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --import tsx scripts/test-e2e-local.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "node --import tsx scripts/prisma.ts generate",
    "db:validate": "tsx scripts/prisma.ts validate",
    "db:format": "tsx scripts/prisma.ts format",
    "db:migrate": "tsx scripts/prisma.ts migrate deploy",
    "db:migrate:create": "node --import tsx scripts/prisma.ts migrate dev",
    "db:migrate:status": "tsx scripts/prisma.ts migrate status",
    "db:status": "tsx scripts/db-status.ts",
    "db:studio": "tsx scripts/prisma.ts studio",
    "admin:password-reset": "tsx scripts/admin-password-reset.ts",
    "retention:clean": "tsx scripts/retention.ts",
    "bench:export": "tsx scripts/benchmark-export.ts",
    "verify:preview-pdf": "node --import tsx scripts/verify-preview-pdf.ts",
    "check:size": "tsx scripts/check-size.ts",
    "stress:export": "tsx scripts/stress-export.ts",
    "validate:epub": "node --import tsx scripts/validate-epub.ts",
    "validate:docx": "node --import tsx scripts/validate-docx.ts",
    "validate:docx:libreoffice": "tsx scripts/validate-docx-libreoffice.ts",
    "validate:pdf": "node --import tsx scripts/validate-pdf.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.3",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
